# https://developers.openai.com/codex/rules/

prefix_rule(
  pattern = ["bundle", "update"],
  decision = "allow",
  match = [
    "bundle update",
    "bundle update rails"
  ],
)

prefix_rule(
  pattern = ["bundle", "add"],
  decision = "allow",
  match = [
    "bundle add rails",
    "bundle add foo --group development"
  ],
)

prefix_rule(
  pattern = ["git", "commit", "--amend"],
  decision = "forbidden",
  justification = "Do not amend commits from Codex.",
)

prefix_rule(
  pattern = [["cap", "bin/cap", "./bin/cap"], ["production", "staging"]],
  decision = "forbidden",
  justification = "No Capistrano on production or staging",
)

prefix_rule(
  pattern = ["bundle", "exec", "cap", ["production", "staging"]],
  decision = "forbidden",
  justification = "No Capistrano on production or staging",
)

prefix_rule(
  pattern = ["git", "commit", ["-m", "--message"]],
  decision = "allow",
)

prefix_rule(
  pattern = ["gh", "run", ["list", "view", "watch", "download"]],
  decision = "allow",
  match = [
    "gh run list",
    "gh run view 12345",
    "gh run watch 12345",
    "gh run download 12345"
  ],
)

prefix_rule(
  pattern = ["gh", "issue", ["view", "list", "status"]],
  decision = "allow",
  match = [
    "gh issue view 123",
    "gh issue list",
    "gh issue status",
  ],
  not_match = [
    "gh issue edit 123",
  ],
)

prefix_rule(
  pattern = ["gh", "pr", ["view", "list", "status", "diff", "checks"]],
  decision = "allow",
  match = [
    "gh pr view 123",
    "gh pr list",
    "gh pr status",
    "gh pr diff 123",
    "gh pr checks 123",
  ],
  not_match = [
    "gh pr create",
  ],
)

prefix_rule(
  pattern = ["gh", "repo", ["view", "list"]],
  decision = "allow",
  match = [
    "gh repo view openai/codex",
    "gh repo list openai",
  ],
  not_match = [
    "gh repo delete openai/codex",
  ],
)

prefix_rule(
  pattern = ["gh", "search"],
  decision = "allow",
  match = [
    "gh search code execpolicy",
    "gh search issues sandbox",
  ],
)

prefix_rule(
  pattern = ["gh", "auth", "status"],
  decision = "allow",
  match = [
    "gh auth status",
  ],
  not_match = [
    "gh auth login",
    "gh auth logout",
  ],
)
